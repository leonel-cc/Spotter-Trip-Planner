DEBUG=true
SECRET_KEY=replace-with-a-random-secret-before-deployment
ALLOWED_HOSTS=localhost,127.0.0.1
# Without an ORS key, the app uses OSRM general driving routes, clearly labelled.
ORS_API_KEY=
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
MAP_USER_AGENT=SpotterTripPlanner/1.0 (assessment demo)
REVERSE_GEOCODING=true

# Vercel defaults to Photon; local and single-instance Docker deployments use Nominatim.
# Leave unset to use the environment's default.
# GEOCODING_PROVIDER=photon
# PHOTON_BASE_URL=https://photon.komoot.io
